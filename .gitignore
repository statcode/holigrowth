# ──────────────────────────────────────────────────────────────────────────────
# Dependencies
# ──────────────────────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.npm/

# ──────────────────────────────────────────────────────────────────────────────
# Build outputs and TS incremental caches
# (pnpm-lock.yaml is intentionally NOT ignored — should be committed.)
# ──────────────────────────────────────────────────────────────────────────────
dist/
build/
**/dist/
**/build/
*.tsbuildinfo
.cache/
.vite/
.turbo/
.parcel-cache/

# ──────────────────────────────────────────────────────────────────────────────
# Environment & secrets
# Pattern: ignore .env and any .env.* variant, but allow committed examples.
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.sample

# Generic credential files — if any of these ever appear in the tree they
# almost certainly shouldn't be committed.
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
service-account*.json
gcp-key*.json

# ──────────────────────────────────────────────────────────────────────────────
# Runtime / local-only artifacts
# ──────────────────────────────────────────────────────────────────────────────
# Smoke-test PDF output — generated by `pnpm --filter @workspace/api-server run smoke-pdf`
test-output/

# Local file storage for the api-server's object-storage layer — holds
# generated per-customer PDFs and may contain personal birth data.
artifacts/uploads/

# Claude Code / IDE agent session state — may contain conversation
# transcripts with API keys or other sensitive material.
.claude/

# ──────────────────────────────────────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ──────────────────────────────────────────────────────────────────────────────
# Editor & OS junk
# ──────────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ──────────────────────────────────────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────────────────────────────────────
*.bak
*.tmp
.tmp/
coverage/
