# Cloudways' default vhost on Apache 2.4 doesn't auto-grant access to a
# webroot moved into a subdirectory like /dist. Without this, every request
# 401s with "client denied by server configuration" (mod_authz_core),
# which Cloudways' default error document presents as {"error":"Unauthorized"}.
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

# Make sure index.html is the directory default (Cloudways' vhost only
# lists index.php by default, which doesn't exist in this SPA build).
DirectoryIndex index.html

RewriteEngine On

# Tell the Node backend the original public host + scheme. The expr= prefix
# evaluates an Apache 2.4 expression at request time. Wrapped in IfModule so
# the file doesn't 500 if mod_headers is missing.
<IfModule mod_headers.c>
    RequestHeader set X-Forwarded-Host "expr=%{HTTP_HOST}"
    RequestHeader set X-Forwarded-Proto "expr=%{REQUEST_SCHEME}"
</IfModule>

# Forward /api/* to the Node backend (PM2-managed) on the loopback interface.
# Port must match PORT in the server's .env file. holigrowth uses 8089 to
# avoid colliding with colorgifts' API on 8088 (both apps live on the same
# Cloudways VM and bind to the host loopback).
RewriteRule ^api/(.*)$ http://127.0.0.1:8089/api/$1 [P,L]

# SPA fallback: any non-file, non-directory request serves index.html so
# wouter's client-side routes (e.g. /admin, /create, /order/:id, /privacy)
# don't 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
